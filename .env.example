# docker-compose 用の設定。これを .env にコピーして各デスクトップで埋める。
#   cp .env.example .env
#
# ⚠ .env は2箇所にあり、役割が違う（紛らわしいので注意）:
#   - デスクトップの compose と同じ階層 … docker compose が読む（下記の NAS_*）
#   - NAS 上の /srv/movieedit2/.env      … アプリ本体が読む（ANTHROPIC_API_KEY）
#   詳細は DOCKER_SETUP.md 2-5

# NAS（中古ノート）の情報
NAS_HOST=192.168.1.10        # NAS の LAN IP（固定推奨）
NAS_SHARE=movieedit2         # Samba の共有名（movieedit2 一式を置くフォルダ）
NAS_USER=movieedit           # Samba ユーザー
NAS_PASS=change-me           # Samba パスワード
